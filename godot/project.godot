; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sprite Sheep"
config/use_custom_user_dir=true
config/custom_user_dir_name="Sprite Sheep"
config/description="Da uno sprite e un prompt genera sprite sheet animati e GIF."
config/version="0.0.3-pre-alpha"
run/main_scene="res://scenes/main.tscn"
config/icon="res://icon.png"
config/features=PackedStringArray("4.6", "GL Compatibility")

[internationalization]

locale/translations=PackedStringArray("res://traduzioni.it.translation", "res://traduzioni.en.translation")

[display]

window/size/viewport_width=1400
window/size/viewport_height=900
window/size/mode=2
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
